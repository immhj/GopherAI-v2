# Template for the container configuration.
#
#   cp config/config.docker.toml.example config/config.docker.toml
#
# Then fill in the values marked below. The real config.docker.toml is
# gitignored because it holds live credentials.
#
# docker-compose mounts config/config.docker.toml into the backend container,
# so this file must exist before running `docker compose up`.

[mainConfig]
appName = "GopherAI"
host = "0.0.0.0"
port = 9090

# Used to email registration captchas. For QQ Mail, `authcode` is the
# SMTP authorisation code (NOT your login password): QQ Mail settings ->
# account -> enable POP3/SMTP -> generate code.
[emailConfig]
authcode = "your-smtp-authcode"
email = "your-email@qq.com"

# Service hostnames below match the docker-compose service names.
[redisConfig]
host = "redis"
port = 6379
password = ""
db = 0

[mysqlConfig]
host = "mysql"
port = 3306
user = "root"
password = "123456"
databaseName = "GopherAI"
charset =  "utf8mb4"

[jwtConfig]
 expire_duration= 8760
 issuer= "huanheart"
 subject= "GopherAI"
 key= "change-me-in-production"

 [rabbitmqConfig]
  host= "rabbitmq"
  port= 5672
  username= "root"
  password= "123456"
  vhost= "/"

 # Chat models are reached through one OpenAI-compatible gateway.
  # The auth key comes from the ANTHROPIC_API_KEY environment variable.
  # host.docker.internal lets the container reach a gateway on the host.
  [modelServiceConfig]
  baseUrl = "http://host.docker.internal:8085/v1"
  defaultModel = "claude-opus-5"
  models = ["claude-opus-5", "gpt-5.6-sol"]

  # Vector database for RAG document chunks.
  [qdrantConfig]
  url = "http://qdrant:6333"
  collection = "documents"

  # Document embedding via Volcengine Ark. Key comes from ARK_API_KEY.
  # Only the vision series is currently available (the text-only embedding
  # models were retired); it accepts plain text just fine.
  # The endpoint handles one input per request, so concurrency is used instead
  # of batching. `dimensions` asks the model to reduce output size.
  [embeddingConfig]
  baseUrl = "https://ark.cn-beijing.volces.com/api/v3"
  model = "doubao-embedding-vision-250615"
  dimensions = 1024
  concurrency = 5

  # Chunking and retrieval parameters.
  [ragConfig]
  chunkSize = 700
  chunkOverlap = 100
  topK = 5
  scoreThreshold = 0.3
