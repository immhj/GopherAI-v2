# Copy this file to ".env" and fill in your credentials.
# These are consumed by the backend container (see docker-compose.yml).

# Chat model gateway (OpenAI-compatible reverse proxy) auth key.
# Used to call the selectable models (claude-opus-5, gpt-5.6-sol, ...).
ANTHROPIC_API_KEY=

# Volcengine Ark key, used to vectorise uploaded documents for RAG.
# Required if you want document retrieval; chat works without it.
ARK_API_KEY=
