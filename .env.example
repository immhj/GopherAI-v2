# Copy this file to ".env" and fill in your credentials.
# These are consumed by the backend container (see docker-compose.yml).

# Chat model gateway (Aether reverse proxy, OpenAI-compatible) auth key.
# Used to call the selectable models (claude-opus-5, gpt-5.6-sol, ...).
ANTHROPIC_API_KEY=

# RAG embedding provider key (Aliyun DashScope, OpenAI-compatible). Optional:
# only needed for document (RAG) Q&A. Leave blank to disable RAG gracefully.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=qwen-turbo
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
